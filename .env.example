# PostgreSQL
DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/gureumtalk

# Groq AI chatbot
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.6-27b

# Login session
SESSION_SECRET_KEY=replace_with_a_long_random_value

# Local embedding model
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Local Qdrant storage
QDRANT_LOCAL_PATH=knowledge_base/qdrant_data
QDRANT_COLLECTION_NAME=gureumtalk_service_policy
